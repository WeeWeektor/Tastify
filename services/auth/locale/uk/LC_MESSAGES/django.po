#: .\authentication\services\email_service.py:45
msgid "Registration Confirmation at Tastify"
msgstr "Підтвердження реєстрації у Tastify"

#: .\authentication\services\email_service.py:48
#, python-brace-format
msgid ""
"Welcome to Tastify!\n"
"\n"
"To complete your registration and activate your account, please follow the "
"link:\n"
"{link}\n"
"\n"
"This link is valid for 24 hours.\n"
"If you did not register on our site, please ignore this email."
msgstr ""
"Вітаємо у Tastify!\n"
"\n"
"Щоб завершити реєстрацію та активувати акаунт, перейдіть за посиланням:\n"
"{link}\n"
"\n"
"Це посилання дійсне 24 години.\n"
"Якщо ви не реєструвалися на нашому сайті, просто проігноруйте цей лист."

#: .\authentication\services\email_service.py:58
msgid "Welcome to Tastify! 🍔"
msgstr "Вітаємо у Tastify! 🍔"

#: .\authentication\services\email_service.py:59
msgid ""
"To complete your registration and activate your account, click the button "
"below:"
msgstr "Щоб завершити реєстрацію та активувати акаунт, натисніть кнопку нижче:"

#: .\authentication\services\email_service.py:61
msgid "Confirm Email"
msgstr "Підтвердити Email"

#: .\authentication\services\email_service.py:63
msgid "This link is valid for 24 hours."
msgstr "Це посилання дійсне 24 години."

#: .\authentication\services\email_service.py:85
msgid "Password Reset at Tastify"
msgstr "Скидання пароля у Tastify"

#: .\authentication\services\email_service.py:88
#, python-brace-format
msgid ""
"You received this email because a password reset request was made for your "
"Tastify account.\n"
"\n"
"To set a new password, please follow the link:\n"
"{link}\n"
"\n"
"This link is valid for 1 hour.\n"
"If you did not request this, please ignore this email; your password will "
"remain unchanged."
msgstr ""
"Ви отримали цей лист, оскільки було зроблено запит на скидання пароля для "
"вашого акаунту Tastify.\n"
"\n"
"Щоб встановити новий пароль, перейдіть за посиланням:\n"
"{link}\n"
"\n"
"Це посилання дійсне 1 годину.\n"
"Якщо ви не робили цей запит, просто проігноруйте цей лист; ваш пароль "
"залишиться без змін."

#: .\authentication\services\email_service.py:98
msgid "Password Reset 🍔"
msgstr "Скидання пароля 🍔"

#: .\authentication\services\email_service.py:99
msgid "To set a new password, click the button below:"
msgstr "Щоб встановити новий пароль, натисніть кнопку нижче:"

#: .\authentication\services\email_service.py:101
msgid "Reset Password"
msgstr "Скинути пароль"

#: .\authentication\services\email_service.py:103
msgid "This link is valid for 1 hour."
msgstr "Це посилання дійсне 1 годину."

